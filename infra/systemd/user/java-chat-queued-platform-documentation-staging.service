[Unit]
Description=Append all remaining queued documentation embeddings
After=java-chat-local-embedding-staging.service
ConditionPathExists=!%h/.local/state/java-chat/queued-platform-documentation-staging.complete
ConditionPathExists=%h/.local/state/java-chat/local-embedding-staging.invocation

[Service]
Type=oneshot
WorkingDirectory=%h/Developer/git/java-chat
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/java-chat
ExecStart=/bin/bash -lc 'invocation_id=$(systemctl --user show java-chat-local-embedding-staging.service --property=InvocationID --value); if [ -z "$invocation_id" ]; then invocation_id=$(<%h/.local/state/java-chat/local-embedding-staging.invocation); fi; exec infisical run --projectId b92b6dcd-4ecf-4fe4-9f62-7580a5610d47 --env dev -- %h/Developer/git/java-chat/scripts/run_queued_platform_documentation_staging.sh --after-invocation=$invocation_id'
ExecStartPost=/usr/bin/touch %h/.local/state/java-chat/queued-platform-documentation-staging.complete
Restart=on-failure
RestartSec=15s
TimeoutStopSec=20s
