[Unit]
Description=Process the local JavaChat embedding backlog
OnSuccess=java-chat-queued-platform-documentation-staging.service
ConditionPathExists=!%h/.local/state/java-chat/local-embedding-staging.complete

[Service]
Type=exec
WorkingDirectory=%h/Developer/git/java-chat
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/java-chat
ExecStartPre=/usr/bin/rm -f %h/.local/state/java-chat/local-embedding-staging.invocation %h/.local/state/java-chat/local-embedding-staging.invocation.next
ExecStart=/bin/bash -lc 'infisical run --projectId b92b6dcd-4ecf-4fe4-9f62-7580a5610d47 --env dev -- %h/Developer/git/java-chat/scripts/run_local_embedding_staging.sh && /usr/bin/printf "%s\n" "$INVOCATION_ID" > %h/.local/state/java-chat/local-embedding-staging.invocation.next && /usr/bin/mv -- %h/.local/state/java-chat/local-embedding-staging.invocation.next %h/.local/state/java-chat/local-embedding-staging.invocation && /usr/bin/touch %h/.local/state/java-chat/local-embedding-staging.complete'
Restart=on-failure
RestartSec=15s
TimeoutStopSec=20s

[Install]
WantedBy=default.target
